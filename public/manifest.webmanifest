{
  "name": "TaskFlow Pro",
  "short_name": "TaskFlow",
  "description": "Offline-first personal operating system: tasks, workouts and habits in one timeline.",
  "id": "./",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#e0e5ec",
  "theme_color": "#e0e5ec",
  "categories": ["productivity", "health", "lifestyle"],
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "./?tab=today", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Workout", "url": "./?tab=workout", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Habits", "url": "./?tab=habits", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
